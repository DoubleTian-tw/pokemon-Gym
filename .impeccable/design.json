      "html": "<button class=\"ds-btn-primary\">完成</button>",
      "css": ".ds-btn-primary{min-height:40px;padding:8px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.35);background:linear-gradient(to bottom,#0066d6,#0052b3);color:#fff;font:600 13px -apple-system,sans-serif;box-shadow:0 4px 14px rgba(0,0,0,.36),inset 0 1px 0 rgba(255,255,255,.45);transition:filter .15s,transform .15s}.ds-btn-primary:hover{filter:brightness(1.1)}.ds-btn-primary:active{transform:scale(.96)}.ds-btn-primary:focus-visible{outline:2px solid #60a5fa;outline-offset:2px}"
    },
    {
      "name": "Glass Secondary Button",
      "kind": "button",
      "refersTo": "button-glass-secondary",
