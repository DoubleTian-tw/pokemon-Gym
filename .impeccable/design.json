      "css": ".ds-dock{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;width:340px;padding:4px;border-radius:999px;background:rgba(22,26,39,.72);backdrop-filter:blur(24px) saturate(190%);border:1px solid rgba(255,255,255,.2);box-shadow:0 12px 32px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.36)}.ds-tab{min-height:40px;display:flex;align-items:center;justify-content:center;border-radius:999px;color:rgba(226,232,240,.84);font:600 13px -apple-system,sans-serif;transition:background .15s}.ds-tab:hover{background:rgba(255,255,255,.08);color:#fff}.ds-tab.is-active{background:rgba(255,255,255,.16);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.38)}"
