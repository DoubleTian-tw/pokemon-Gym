      "html": "<div class=\"ds-panel\">敵方道館守衛 (4 / 6)</div>",
      "css": ".ds-panel{padding:10px;border-radius:22px;font:600 13px -apple-system,sans-serif;background:rgba(18,22,34,.56);backdrop-filter:blur(20px) saturate(180%);border:1px solid rgba(255,255,255,.18);box-shadow:0 8px 24px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.32);color:#f8fafc;}"
