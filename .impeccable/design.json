  "narrative": {
    "northStar": "Tactile Liquid Glass Observatory",
    "overview": "深石墨畫布搭配隨守衛主屬性變化的低飽和氛圍光暈，上層為磨砂玻璃面板；彩度集中在寶可夢插圖、18 屬性色與紅綠語意連線。",
    "keyCharacteristics": [
      "磨砂玻璃加上緣高光",
      "隨屬性變化的氛圍光暈",
      "CSS 變數管理的圓角層級",
      "綠實線剋制、紅虛線反打"
    ],
    "rules": [
      {
        "name": "The Chromatic Separation Rule",
        "body": "屬性色只用於屬性標籤、色點與節點光環；剋制與反打一律用語意綠與紅。",
        "section": "colors"
      },
      {
        "name": "The Restrained Ambient Rule",
        "body": "氛圍光暈透明度維持 0.20–0.28。",
        "section": "colors"
      },
      {
        "name": "The Tabular Numerals Rule",
        "body": "動態數字一律 tabular-nums。",
        "section": "typography"
      },
      {
        "name": "The Specular Top Rim Rule",
        "body": "主要玻璃面板必有 1px 上緣內高光。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 在主要玻璃容器使用 .glass-blur / .glass-dock / .glass-sheet 工具類，維持上緣高光邊。",
      "Do 為所有玻璃表面提供 prefers-reduced-transparency 與 prefers-reduced-motion 退路。",
      "Do 讓無選擇時有冷光後備色，避免空白狀態畫面死黑。",
      "Do 在粗指標裝置維持 44px 以上觸控目標。"
    ],
    "donts": [
      "Don't 在畫布節點或邊線上加入高不透明度多色漸層文字或霓虹大光暈。",
      "Don't 在卡片內再巢狀包多層高透明度玻璃卡片。",
      "Don't 在 390px 窄螢幕下把守衛槽位縮到截斷圖片或讓觸控鈕過小。",
      "Don't 用屬性色表示剋制或反打方向。"
    ]
  }
